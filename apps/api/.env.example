NODE_ENV="development"
HOST="0.0.0.0"
PORT="3000"
API_PREFIX="v1"
LOG_LEVEL="info"
TRUST_PROXY="false"
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"
SWAGGER_ENABLED="true"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="1 minute"
MAX_BODY_SIZE="62914560"
MEDIA_STORAGE_ROOT="./uploads"
MEDIA_PUBLIC_URL=""

DATABASE_URL="postgresql://postgres:root@localhost:5432/brand_deals?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
ADMIN_OWNER_EMAIL="owner@your-company.com"
ADMIN_OWNER_PASSWORD="replace-with-an-admin-password"
ADMIN_MODERATOR_EMAIL="moderator@your-company.com"
ADMIN_MODERATOR_PASSWORD="replace-with-a-moderator-password"

DATA_GOV_IN_API_KEY="replace-with-a-server-side-data.gov.in-api-key"
LGD_CACHE_DIR="./data/lgd"
LGD_PAGE_SIZE="2000"

# WhatsApp delivery (server-side only; never add these to the mobile app)
WHATSAPP_ENABLED="false"
WHATSAPP_API_BASE_URL="https://wa-api.suthartech.com"
WHATSAPP_API_KEY="replace-with-your-wa-api-key"
WHATSAPP_SESSION="replace-with-your-wa-session"
WHATSAPP_SENDER_NAME="Brandly"

# Required when an admin saves encrypted provider settings in the database.
APP_CONFIG_ENCRYPTION_KEY="replace-with-a-random-secret-at-least-32-characters"

# SMTP fallback for local development (server-only; never add these to mobile)
SMTP_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_ENCRYPTION="TLS"
SMTP_USERNAME="your-sender@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
SMTP_FROM_NAME="Brandly"
SMTP_FROM_EMAIL="your-sender@gmail.com"
SMTP_REPLY_TO=""
