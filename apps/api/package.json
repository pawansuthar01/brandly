{
  "name": "@brand-deals/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "prestart:prod": "npm run db:migrate",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/workers/reminder-worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "locations:sync": "tsx scripts/sync-lgd-locations.ts",
    "locations:verify": "tsx scripts/sync-lgd-locations.ts --verify-only",
    "locations:export-mobile": "tsx scripts/export-mobile-india-locations.ts",
    "typecheck": "tsc --noEmit",
    "test:reminders": "node scripts/test-reminders.cjs",
    "test:chat": "node scripts/test-chat.cjs",
    "test:social-reviews": "tsx scripts/test-social-reviews.ts",
    "test:analytics": "tsx scripts/test-analytics.ts",
    "test:notifications:admin": "tsx scripts/test-notifications-admin.ts",
    "test:themes": "tsx scripts/test-themes.ts",
    "test:themes:http": "node --env-file=.env --import tsx scripts/test-themes-http.ts",
    "load:themes:local": "node --env-file=.env --import tsx scripts/load-themes-local.ts"
  },
  "prisma": {
    "schema": "src/database/schema.prisma"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/platform-ws": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/client": "^6.16.0",
    "@types/nodemailer": "^8.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "prisma": "^6.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
